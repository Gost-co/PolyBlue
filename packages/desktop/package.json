{
  "name": "@polyblue/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Cross-platform desktop wrapper for PolyBlue (Windows, Linux, macOS)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:linux": "electron-builder --linux AppImage deb",
    "package:win": "electron-builder --win nsis portable",
    "package:mac": "electron-builder --mac dmg"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "build": {
    "appId": "org.polyblue.desktop",
    "productName": "PolyBlue",
    "directories": {
      "output": "../../release"
    },
    "linux": {
      "category": "Audio;Utility"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "category": "public.app-category.utilities"
    }
  }
}
